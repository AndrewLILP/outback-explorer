<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIToolkit/USS/AnimalInfo.uss?fileID=7433441132597879392&amp;guid=ed239d77e4b41414d94475a9f67d80ce&amp;type=3#AnimalInfo"/>
    <ui:VisualElement name="animal-info-root" class="animal-panel">
        <ui:VisualElement name="animal-info-container" class="animal-panel-container">
            <ui:VisualElement name="header-section" class="header-section">
                <ui:VisualElement name="animal-icon" class="animal-icon"/>
                <ui:VisualElement name="name-container" class="name-container">
                    <ui:Label name="animal-name" text="Animal Name" class="animal-name-label"/>
                    <ui:Label name="scientific-name" text="Scientific Name" class="scientific-name-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="divider" class="divider"/>
            <ui:VisualElement name="info-section" class="info-section">
                <ui:VisualElement name="habitat-container" class="info-row">
                    <ui:Label name="habitat-label" text="📍 Habitat:" class="info-label"/>
                    <ui:Label name="habitat-value" text="Habitat description" class="info-value"/>
                </ui:VisualElement>
                <ui:VisualElement name="diet-container" class="info-row">
                    <ui:Label name="diet-label" text="🍃 Diet:" class="info-label"/>
                    <ui:Label name="diet-value" text="Diet description" class="info-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="fun-fact-section" class="fun-fact-section">
                <ui:Label name="fun-fact-label" text="💡 Fun Fact:" class="fun-fact-label"/>
                <ui:Label name="fun-fact-value" text="Fun fact about the animal goes here!" class="fun-fact-value"/>
            </ui:VisualElement>
            <ui:VisualElement name="discovery-badge" class="discovery-badge">
                <ui:Label name="discovery-text" text="🆕 Discovered!" class="discovery-badge-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!--
        No <Style> tag here on purpose - assign AnimalInfoPanel.uss to the
        animalInfoStyleSheet field on this GameObject's AnimalInfoUI
        component in the Inspector instead. (Avoids hand-typing a project://
        GUID that only Unity's own UI Builder can generate correctly.)
    -->
    <ui:VisualElement name="animal-info-root" class="animal-panel animal-panel--hidden">
        <ui:VisualElement name="animal-info-container" class="journal-card">
            <ui:VisualElement name="animal-icon" class="journal-icon" />
            <ui:VisualElement class="journal-body">
                <ui:VisualElement class="journal-header-row">
                    <ui:Label name="animal-name" text="Animal name" class="journal-name" />
                    <ui:Label name="scientific-name" text="Scientific name" class="journal-sci-name" />
                </ui:VisualElement>
                <ui:Label name="fun-fact-value" text="Fun fact about the animal goes here." class="journal-fun-fact" />
                <ui:VisualElement class="journal-meta-row">
                    <ui:Label text="Habitat" class="journal-meta-label" />
                    <ui:Label name="habitat-value" text="Habitat description" class="journal-meta-value" />
                    <ui:Label text="Diet" class="journal-meta-label" />
                    <ui:Label name="diet-value" text="Diet description" class="journal-meta-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="discovery-badge" class="journal-badge">
                <ui:Label name="discovery-text" text="New discovery" class="journal-badge-text" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
