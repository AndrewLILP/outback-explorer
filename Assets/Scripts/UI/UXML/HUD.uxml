<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/USS/HUD.uss?fileID=7433441132597879392&amp;guid=62f7dd346571de947be06addefd2eca8&amp;type=3#HUD" />
    <ui:VisualElement name="HUD" class="hud-container">
        <ui:VisualElement name="Speedometer" class="speedometer">
            <ui:Label name="SpeedLabel" text="0" class="speed-value" />
            <ui:Label text="km/h" class="speed-unit" />
            <ui:Label name="SpeedComparison" text="Take your time... 🐌" class="speed-comparison" />
        </ui:VisualElement>
        <ui:VisualElement name="DiscoveryProgress" class="discovery-progress">
            <ui:Label name="ProgressText" text="0/7 Animals Discovered" class="progress-text" />
            <ui:VisualElement name="AnimalIcons" class="animal-icons">
                <!-- Row 1: Easy Finds (Kangaroo, Emu, Echidna, Tasmanian Devil) -->
                <ui:VisualElement name="Row1" class="animal-row">
                    <ui:VisualElement name="KangarooContainer" class="animal-container">
                        <ui:VisualElement name="KangarooIcon" class="animal-icon undiscovered" />
                        <ui:Label name="KangarooLabel" text="?" class="animal-label" />
                        <ui:Label text="🦘" class="animal-emoji" />
                    </ui:VisualElement>
                    <ui:VisualElement name="EmuContainer" class="animal-container">
                        <ui:VisualElement name="EmuIcon" class="animal-icon undiscovered" />
                        <ui:Label name="EmuLabel" text="?" class="animal-label" />
                        <ui:Label text="🦤" class="animal-emoji" />
                    </ui:VisualElement>
                    <ui:VisualElement name="EchidnaContainer" class="animal-container">
                        <ui:VisualElement name="EchidnaIcon" class="animal-icon undiscovered" />
                        <ui:Label name="EchidnaLabel" text="?" class="animal-label" />
                        <ui:Label text="🦔" class="animal-emoji" />
                    </ui:VisualElement>
                    <ui:VisualElement name="DevilContainer" class="animal-container">
                        <ui:VisualElement name="DevilIcon" class="animal-icon undiscovered" />
                        <ui:Label name="DevilLabel" text="?" class="animal-label" />
                        <ui:Label text="😈" class="animal-emoji" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Row 2: Hard Finds (Koala, Frillneck Lizard, Platypus) -->
                <ui:VisualElement name="Row2" class="animal-row">
                    <ui:VisualElement name="KoalaContainer" class="animal-container">
                        <ui:VisualElement name="KoalaIcon" class="animal-icon undiscovered" />
                        <ui:Label name="KoalaLabel" text="?" class="animal-label" />
                        <ui:Label text="🐨" class="animal-emoji" />
                    </ui:VisualElement>
                    <ui:VisualElement name="FrillneckContainer" class="animal-container">
                        <ui:VisualElement name="FrillneckIcon" class="animal-icon undiscovered" />
                        <ui:Label name="FrillneckLabel" text="?" class="animal-label" />
                        <ui:Label text="🦎" class="animal-emoji" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlatypusContainer" class="animal-container">
                        <ui:VisualElement name="PlatypusIcon" class="animal-icon undiscovered" />
                        <ui:Label name="PlatypusLabel" text="?" class="animal-label" />
                        <ui:Label text="🦆" class="animal-emoji" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MissionIndicator" class="mission-indicator">
            <ui:Label name="MissionText" class="mission-text" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PauseMenu" class="pause-menu" style="display: none;">
        <ui:VisualElement name="PauseContainer" class="pause-container">
            <ui:Label text="PAUSED" class="pause-title" />
            <ui:Button name="ResumeButton" text="Resume" class="pause-button" />
            <ui:Button name="SaveButton" text="Save Game" class="pause-button" />
            <ui:Button name="NewGameButton" text="New Game" class="pause-button" />
            <ui:Button name="InstructionsButton" text="Instructions" class="pause-button" />
        </ui:VisualElement>
        <ui:VisualElement name="InstructionsPanel" class="instructions-panel" style="display: none;">
            <ui:Label text="CONTROLS" class="instructions-title" />
            <ui:VisualElement class="instructions-content">
                <ui:Label text="WASD / Arrow Keys - Drive" class="instruction-line" />
                <ui:Label text="Space - Brake" class="instruction-line" />
                <ui:Label text="E - Enter/Exit Car" class="instruction-line" />
                <ui:Label text="Mouse - Look Around" class="instruction-line" />
                <ui:Label text="ESC - Pause Menu" class="instruction-line" />
                <ui:Label class="instruction-spacer" />
                <ui:Label text="SAVE/LOAD" class="instruction-line" />
                <ui:Label text="F5 - Quick Save" class="instruction-line" />
                <ui:Label text="F6 - Quick Load" class="instruction-line" />
                <ui:Label text="F7 - Delete Save" class="instruction-line" />
                <ui:Label text="F8 - New Game" class="instruction-line" />
            </ui:VisualElement>
            <ui:Button name="CloseInstructionsButton" text="Close" class="pause-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
