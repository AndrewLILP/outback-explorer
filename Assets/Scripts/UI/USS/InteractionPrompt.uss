/* InteractionPrompt.uss - matches the warm palette used in HUD.uss / AnimalInfoPanel.uss */

.interaction-prompt-container {
    position: absolute;
    bottom: 160px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
}

.interaction-prompt {
    flex-direction: row;
    align-items: center;
    background-color: rgba(44, 38, 28, 0.88);
    border-radius: 999px;
    border-width: 1px;
    border-color: rgba(196, 164, 105, 0.55);
    padding: 8px 16px;
}

.interaction-icon {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgba(196, 164, 105, 0.25);
    border-width: 1px;
    border-color: rgb(196, 164, 105);
    color: rgb(238, 230, 214);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 10px;
}

.prompt-text {
    font-size: 14px;
    color: rgb(238, 230, 214);
    -unity-text-align: middle-left;
}
