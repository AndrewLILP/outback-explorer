/* HUD.uss
   Warm "field journal" palette - replaces the old dark sci-fi blue/green look.
   Shared tones used across HUD, AnimalInfoPanel and InteractionPrompt for a
   consistent road-trip feel:
   - Panel surface:  rgba(44, 38, 28, 0.88)  deep leather/coffee brown
   - Panel border:   rgba(196, 164, 105, 0.55) brass/tan
   - Primary text:   rgb(238, 230, 214)      cream
   - Secondary text: rgba(196, 180, 150, 0.85) muted tan
   - Rust accent:    rgb(196, 110, 58)       (kangaroo / discovered highlight)
   - Olive accent:   rgb(122, 138, 84)       (frillneck / secondary highlight)
*/

.hud-container {
    width: 100%;
    height: 100%;
}

/* ===================================
   SPEED COMPARISON (bottom-center, floats just above RCC's own dash)
   =================================== */
.speed-panel {
    position: absolute;
    bottom: 110px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
}

.speed-comparison-text {
    background-color: rgba(44, 38, 28, 0.78);
    border-radius: 999px;
    border-width: 1px;
    border-color: rgba(196, 164, 105, 0.5);
    padding: 6px 18px;
    font-size: 14px;
    color: rgb(238, 230, 214);
    -unity-text-align: middle-center;
}

/* ===================================
   DISCOVERY WIDGET (bottom-left: pill + expandable stamp grid)
   =================================== */
.discovery-widget {
    position: absolute;
    bottom: 30px;
    left: 30px;
    align-items: flex-start;
}

.discovery-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(44, 38, 28, 0.85);
    border-radius: 999px;
    border-width: 1px;
    border-color: rgba(196, 164, 105, 0.55);
    padding: 8px 16px;
    margin: 0;
    transition-duration: 0.15s;
}

.discovery-pill:hover {
    border-color: rgba(196, 164, 105, 0.9);
    scale: 1.03;
}

.discovery-pill:active {
    scale: 0.97;
}

.discovery-dots {
    flex-direction: row;
}

.discovery-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 5px;
}

.discovery-dot--empty {
    background-color: rgba(196, 180, 150, 0.3);
}

.discovery-dot--filled {
    background-color: rgb(196, 110, 58);
}

.discovery-count-label {
    font-size: 13px;
    color: rgb(238, 230, 214);
    margin-left: 4px;
    -unity-text-align: middle-left;
}

.discovery-grid {
    flex-direction: row;
    flex-wrap: wrap;
    max-width: 360px;
    background-color: rgba(44, 38, 28, 0.9);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(196, 164, 105, 0.55);
    padding: 12px;
    margin-bottom: 8px;
}

.stamp {
    width: 64px;
    align-items: center;
    margin: 4px 6px;
}

.stamp-code {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.stamp-name {
    font-size: 10px;
    color: rgba(196, 180, 150, 0.9);
    -unity-text-align: upper-center;
    white-space: normal;
}

/* Undiscovered - faint dashed-look outline (UI Toolkit has no dashed border,
   so a thin low-contrast border approximates the "blank passport page" look) */
.stamp.undiscovered .stamp-code {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(196, 180, 150, 0.35);
    color: rgba(196, 180, 150, 0.5);
}

/* Discovered - filled ink-stamp circle, slight rotation per species for a
   hand-stamped feel */
.stamp.discovered .stamp-code {
    border-width: 2px;
    color: rgb(44, 38, 28);
}

.stamp.kangaroo.discovered .stamp-code {
    background-color: rgb(196, 110, 58);
    border-color: rgb(140, 75, 35);
    rotate: -6deg;
}

.stamp.frillneck.discovered .stamp-code {
    background-color: rgb(122, 138, 84);
    border-color: rgb(85, 100, 55);
    rotate: 5deg;
}

.stamp.emu.discovered .stamp-code {
    background-color: rgb(180, 150, 90);
    border-color: rgb(130, 105, 60);
    rotate: -3deg;
}

.stamp.echidna.discovered .stamp-code {
    background-color: rgb(140, 100, 70);
    border-color: rgb(95, 65, 45);
    rotate: 4deg;
}

.stamp.devil.discovered .stamp-code {
    background-color: rgb(90, 78, 70);
    border-color: rgb(55, 46, 40);
    rotate: -4deg;
}

.stamp.koala.discovered .stamp-code {
    background-color: rgb(150, 150, 140);
    border-color: rgb(105, 105, 98);
    rotate: 6deg;
}

.stamp.platypus.discovered .stamp-code {
    background-color: rgb(94, 124, 130); /* corrected to a teal-brown tone */
    border-color: rgb(60, 85, 90);
    rotate: -5deg;
}

/* ===================================
   MISSION INDICATOR (top-left, unused in this slice)
   =================================== */
.mission-indicator {
    position: absolute;
    top: 30px;
    left: 30px;
    background-color: rgba(44, 38, 28, 0.85);
    border-radius: 10px;
    padding: 10px 20px;
    min-width: 200px;
    display: none;
}

.mission-text {
    font-size: 16px;
    color: rgb(238, 230, 214);
}

/* ===================================
   PAUSE MENU OVERLAY
   =================================== */
.pause-menu {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 17, 12, 0.75);
    align-items: center;
    justify-content: center;
}

.pause-container {
    background-color: rgba(44, 38, 28, 0.95);
    border-radius: 16px;
    padding: 40px;
    border-width: 1px;
    border-color: rgba(196, 164, 105, 0.5);
    min-width: 360px;
    align-items: center;
}

.pause-title {
    font-size: 36px;
    color: rgb(238, 230, 214);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.pause-button {
    width: 280px;
    height: 46px;
    margin: 8px;
    background-color: rgba(196, 110, 58, 0.25);
    border-radius: 999px;
    border-width: 1px;
    border-color: rgba(196, 164, 105, 0.55);
    color: rgb(238, 230, 214);
    font-size: 16px;
    transition-duration: 0.15s;
}

.pause-button:hover {
    background-color: rgba(196, 110, 58, 0.4);
    border-color: rgba(196, 164, 105, 0.9);
    scale: 1.03;
}

.pause-button:active {
    background-color: rgba(196, 110, 58, 0.55);
    scale: 0.97;
}

/* ===================================
   INSTRUCTIONS PANEL
   =================================== */
.instructions-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 17, 12, 0.85);
    align-items: center;
    justify-content: center;
}

.instructions-title {
    font-size: 28px;
    color: rgb(238, 230, 214);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.instructions-content {
    background-color: rgba(30, 26, 19, 0.9);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 16px;
    min-width: 340px;
}

.instruction-line {
    font-size: 15px;
    color: rgba(196, 180, 150, 0.9);
    margin: 6px 0;
    -unity-text-align: middle-left;
}

.instruction-spacer {
    height: 12px;
}
