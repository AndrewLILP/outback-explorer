/* HUD.uss - Complete Stylesheet for Game HUD */
/* Sprint 5: Updated for 7 animals with 2-row grid layout */

/* ===================================
   MAIN HUD CONTAINER
   =================================== */
.hud-container {
    width: 100%;
    height: 100%;
}

/* ===================================
   SPEEDOMETER (Bottom Right)
   =================================== */
.speedometer {
    position: absolute;
    bottom: 30px;
    right: 30px;
    background-color: rgba(20, 20, 30, 0.8);
    border-radius: 15px;
    padding: 15px 25px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    align-items: center;
    min-width: 120px;
}

.speed-value {
    font-size: 48px;
    color: rgb(100, 200, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.speed-unit {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
    margin-top: 5px;
}

.speed-comparison {
    font-size: 14px;
    color: rgb(255, 200, 100);
    -unity-text-align: middle-center;
    margin-top: 8px;
    font-style: italic;
}

/* ===================================
   ANIMAL DISCOVERY PROGRESS (Top Right)
   =================================== */
.discovery-progress {
    position: absolute;
    top: 30px;
    right: 30px;
    background-color: rgba(30, 40, 30, 0.85);
    border-radius: 12px;
    padding: 15px 20px;
    border-width: 2px;
    border-color: rgba(100, 200, 100, 0.4);
    min-width: 280px; /* Increased from 200px to fit 2 rows */
}

.progress-text {
    font-size: 16px;
    color: rgb(150, 255, 150);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.animal-icons {
    flex-direction: column; /* Stack rows vertically */
    align-items: center;
}

.animal-row {
    flex-direction: row; /* Icons in each row are horizontal */
    justify-content: center;
    align-items: center;
    margin: 5px 0; /* Spacing between rows */
}

.animal-container {
    flex-direction: column;
    align-items: center;
    margin: 0 8px; /* Slightly increased spacing between icons */
}

.animal-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border-width: 2px;
    margin-bottom: 5px;
}

/* Undiscovered state - greyed out */
.animal-icon.undiscovered {
    background-color: rgba(80, 80, 80, 0.5);
    border-color: rgba(100, 100, 100, 0.3);
}

/* Discovered state - colored */
.animal-icon.discovered {
    border-color: rgba(255, 255, 255, 0.6);
}

/* ===================================
   ANIMAL-SPECIFIC COLORS (DISCOVERED STATE)
   =================================== */

/* Row 1 - Easy Finds */
.animal-icon.kangaroo.discovered {
    background-color: rgb(150, 100, 50); /* Brown */
}

.animal-icon.emu.discovered {
    background-color: rgb(80, 100, 120); /* Blue-grey */
}

.animal-icon.echidna.discovered {
    background-color: rgb(120, 90, 70); /* Brown-grey */
}

.animal-icon.devil.discovered {
    background-color: rgb(50, 50, 50); /* Dark grey/black */
}

/* Row 2 - Hard Finds */
.animal-icon.koala.discovered {
    background-color: rgb(120, 120, 130); /* Grey/silver */
}

.animal-icon.frillneck.discovered {
    background-color: rgb(180, 80, 40); /* Orange-red */
}

.animal-icon.platypus.discovered {
    background-color: rgb(70, 90, 100); /* Brown-blue */
}

/* ===================================
   ANIMAL LABELS & EMOJIS
   =================================== */
.animal-label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.animal-emoji {
    font-size: 18px;
    -unity-text-align: middle-center;
    margin-top: 3px;
}

/* ===================================
   MISSION INDICATOR (Top Left)
   =================================== */
.mission-indicator {
    position: absolute;
    top: 30px;
    left: 30px;
    background-color: rgba(30, 30, 40, 0.9);
    border-radius: 10px;
    padding: 10px 20px;
    min-width: 200px;
    display: none; /* Hidden by default */
}

.mission-text {
    font-size: 16px;
    color: rgb(255, 220, 150);
}

/* ===================================
   PAUSE MENU OVERLAY
   =================================== */
.pause-menu {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.pause-container {
    background-color: rgba(30, 30, 40, 0.95);
    border-radius: 20px;
    padding: 40px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.3);
    min-width: 400px;
    align-items: center;
}

.pause-title {
    font-size: 48px;
    color: rgb(255, 220, 150);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 30px;
}

.pause-button {
    width: 300px;
    height: 50px;
    margin: 10px;
    background-color: rgba(60, 80, 100, 0.8);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.pause-button:hover {
    background-color: rgba(80, 120, 160, 0.9);
    border-color: rgba(255, 255, 255, 0.7);
    scale: 1.05;
}

.pause-button:active {
    background-color: rgba(100, 150, 200, 1);
    scale: 0.98;
}

/* ===================================
   INSTRUCTIONS PANEL
   =================================== */
.instructions-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
}

.instructions-title {
    font-size: 36px;
    color: rgb(255, 220, 150);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.instructions-content {
    background-color: rgba(40, 40, 50, 0.9);
    border-radius: 15px;
    padding: 30px;
    margin-bottom: 20px;
    min-width: 400px;
}

.instruction-line {
    font-size: 18px;
    color: rgb(200, 200, 200);
    margin: 8px 0;
    -unity-text-align: middle-left;
}

.instruction-spacer {
    height: 15px;
}
