/* PauseMenu.uss - same warm "field journal" palette as HUD.uss.
   This is now the only UI in PauseMenuScene, so the root fills the screen
   and provides its own dim backdrop (no separate "hud-container" needed). */

.pause-menu {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 17, 12, 0.75);
    align-items: center;
    justify-content: center;
}

.pause-container {
    background-color: rgba(44, 38, 28, 0.95);
    border-radius: 16px;
    padding: 40px;
    border-width: 1px;
    border-color: rgba(196, 164, 105, 0.5);
    min-width: 360px;
    align-items: center;
}

.pause-title {
    font-size: 36px;
    color: rgb(238, 230, 214);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.pause-button {
    width: 280px;
    height: 46px;
    margin: 8px;
    background-color: rgba(196, 110, 58, 0.25);
    border-radius: 999px;
    border-width: 1px;
    border-color: rgba(196, 164, 105, 0.55);
    color: rgb(238, 230, 214);
    font-size: 16px;
    transition-duration: 0.15s;
}

.pause-button:hover {
    background-color: rgba(196, 110, 58, 0.4);
    border-color: rgba(196, 164, 105, 0.9);
    scale: 1.03;
}

.pause-button:active {
    background-color: rgba(196, 110, 58, 0.55);
    scale: 0.97;
}

.instructions-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 17, 12, 0.85);
    align-items: center;
    justify-content: center;
}

.instructions-title {
    font-size: 28px;
    color: rgb(238, 230, 214);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.tutorial-animation-slot {
    width: 320px;
    height: 180px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 12px;
    margin-bottom: 16px;
}

.instructions-content {
    background-color: rgba(30, 26, 19, 0.9);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 16px;
    min-width: 340px;
}

.instruction-line {
    font-size: 15px;
    color: rgba(196, 180, 150, 0.9);
    margin: 6px 0;
    -unity-text-align: middle-left;
}

.instruction-spacer {
    height: 12px;
}
